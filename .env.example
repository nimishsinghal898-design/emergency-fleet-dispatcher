# ==========================================
# Emergency Fleet Command System - Environment Configuration
# Copy this file to .env for local customized overrides.
# ==========================================

# Backend Server Configuration
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=INFO

# Backend CORS Configuration
# Comma-separated list of allowed frontend origins (e.g. for custom production domains).
# Note: Any https://*.vercel.app origin is automatically permitted by default CORS regex.
ALLOWED_ORIGINS=https://your-frontend-project.vercel.app

# Frontend API Configuration
# - Local development: http://127.0.0.1:8000
# - Production (Vercel Frontend): Set to your deployed FastAPI backend URL (e.g. https://your-backend-project.vercel.app)
# IMPORTANT: Never place private secrets or sensitive API keys in VITE_ variables; Vite bakes them into public client-side JS bundles.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Simulation Configuration Defaults
DEFAULT_SEED=20260911
DEFAULT_FLEET_SIZE=20
DEFAULT_INCIDENTS_COUNT=100
DEFAULT_DISPATCHER=coverage
